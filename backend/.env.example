# =============================================================================
# Stock Buddy — single env template (Nest local + Docker Compose)
#
#   cp backend/.env.example backend/.env
#   # edit secrets in backend/.env
#
# Compose (from repo root):
#   docker compose --env-file backend/.env up -d --build
#
# Local Nest uses DATABASE_HOST=localhost.
# Compose overrides DATABASE_HOST=postgres in docker-compose.yml.
# =============================================================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=stock-buddy-dev
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Required — long random string (e.g. openssl rand -base64 48)
JWT_SECRET=change-me-to-a-long-random-secret

# Nest IST cron jobs (off by default for local dev)
# Weekdays: 18:30 nse_sync · 08:45 recommend · 09:14 execute (if auto)
SCHEDULER_ENABLED=false
SCHEDULER_AUTO_EXECUTE=false

DAILY_FUND=100000

# AI provider: mock | openai
AI_PROVIDER=openai

# Required when AI_PROVIDER=openai
OPENAI_API_KEY=sk-...

# OpenAI model id
OPENAI_MODEL=gpt-5.6-luna

POLL_INTERVAL_MS=10000
PORT=3000

# CORS: browser origin of the Next.js UI (comma-separated if needed)
# Local: http://localhost:3001
# OCI:   http://YOUR_PUBLIC_IP:3001
FRONTEND_ORIGIN=http://localhost:3001

# =============================================================================
# Docker Compose host ports + browser API URL (used by compose / frontend build)
# =============================================================================
BACKEND_HOST_PORT=3000
FRONTEND_HOST_PORT=3001

# Baked into the Next.js client at frontend image build time.
# Must be reachable from the browser (not Docker DNS like http://backend:3000).
# Local: http://localhost:3000  ·  OCI: http://YOUR_PUBLIC_IP:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# =============================================================================
# Recommendation knobs (all required — no code defaults)
# =============================================================================
REC_STRATEGY_PROFILE=swing
REC_FULL_CASH_DEPLOY=true
REC_MAX_ALLOC_PCT=0.35
REC_MIN_ALLOC_PCT=0.08
REC_MAX_CASH_LEFTOVER_PCT=0.02
REC_MAX_CASH_LEFTOVER_INR=2500
REC_MIN_DEPLOY_CASH_INR=2500
REC_MAX_PER_DAY=5
REC_MAX_PER_SECTOR=2
# Shortlist: activity (legacy movers) | ranking (research engine)
REC_SHORTLIST_MODE=ranking
# When ranking: keep aligned with RANK_TOP_K. When activity: larger pool OK.
REC_CANDIDATE_LIMIT=40
REC_PRIORITY_POOL=400
REC_MIN_ADTV=50000000
REC_ADTV_LOOKBACK=20
REC_MIN_HISTORY=220
# Share-price floor (INR). Mid/small names like ₹20–80 are fine; only junk below this is cut.
REC_MIN_PRICE=10
REC_AI_INCLUDE_EXTENDED=false
REC_STORE_FULL_PROMPT=false
REC_LEVELS_TOLERANCE=0.05
REC_PRIORITY_WEIGHT_RVOL=1
REC_PRIORITY_WEIGHT_GAP=1
REC_PRIORITY_WEIGHT_ABS_RETURN=1
REC_PRIORITY_CHANGE_TAG_MIN=2
REC_PRIORITY_GAP_TAG_MIN=1.5
REC_PRIORITY_RVOL_TAG_MIN=1.5
REC_PRIORITY_RVOL_SCORE_CAP=10
REC_PRIORITY_VOLUME_FALLBACK_MIN=1000000

# Research Ranking Engine (used when REC_SHORTLIST_MODE=ranking)
RANK_TOP_K=40
RANK_SECTOR_TOP_N=5
RANK_PER_SECTOR_POOL=16
RANK_SECTOR_MODE=hybrid
RANK_WILDCARD_PCT=0.20
RANK_MAX_SECTOR_SHARE=0.25
RANK_MIN_SECTOR_MEMBERS=8
RANK_MISSING_POLICY=redistribute
RANK_REGIME_NOTRADE_ENABLED=false
RANK_SKIP_DAY_RS20=true
RANK_RS_LB_SHORT=5
RANK_RS_LB_SWING=20
RANK_RS_LB_INTERMEDIATE=63
RANK_ADX_PERIOD=14
RANK_52W_BARS=252
RANK_EXT_SOFT_ATR=2.5
RANK_WILDCARD_CANDIDATE_POOL=40
# Bhav sessions for cheap return20 preview (must be >= RANK_RS_LB_SWING + 1)
RANK_BHAV_LOOKBACK=30
# Fail closed if fewer than this fraction of liquid names have return20
RANK_MIN_RETURN20_COVERAGE=0.50
RANK_W_RS=0.25
RANK_W_TREND=0.25
RANK_W_NEAR_HIGH=0.15
RANK_W_PERSISTENCE=0.15
RANK_W_SECTOR=0.10
RANK_W_VOLUME=0.10
RANK_W_EVENT=0.00

# =============================================================================
# Level / setup engine (LVL_*) — all required
#
# BREAKOUT_FRESH
#   Close > highest close of prior LVL_BREAKOUT_LOOKBACK_DAYS bars
#   RVOL >= LVL_RVOL_BREAKOUT_MIN
#   ADX >= LVL_ADX_MIN
#   Close - breakLevel <= LVL_BREAKOUT_MAX_EXT_ATR * ATR
#
# BREAKOUT_RETEST
#   Close-break of that lookback high occurred age 1..LVL_RETEST_LOOKBACK ago
#   Close in [R - LVL_RETEST_BELOW_ATR*ATR, R + LVL_RETEST_ABOVE_ATR*ATR]
#   Last LVL_RETEST_TOUCH_BARS: touched R and held above band floor
#   ADX >= LVL_ADX_MIN
#
# PULLBACK_EMA20
#   EMA20 > EMA50; ADX >= LVL_ADX_MIN
#   Touched EMA20 in last LVL_EMA_TOUCH_BARS; close in EMA pullback band
#
# PULLBACK_PDH
#   EMA20 > EMA50; ADX >= LVL_ADX_MIN
#   PDH broken in LVL_PDH_BREAK_LOOKBACK; close retesting current PDH band
# =============================================================================
LVL_SWING_WINDOW=2
LVL_CLUSTER_ATR=0.25
LVL_BREAK_BUFFER_ATR=0.1
LVL_MIN_TOUCHES=1
LVL_BREAKOUT_LOOKBACK_DAYS=20
LVL_ADX_MIN=25
LVL_EMA_PULLBACK_ATR=0.15
LVL_EMA_MAX_EXT_ATR=1.0
LVL_EMA_BAND_BELOW_ATR=0.25
LVL_EMA_TOUCH_BARS=3
LVL_PDH_BREAK_LOOKBACK=5
LVL_PDH_RETEST_BELOW_ATR=0.25
LVL_PDH_RETEST_ABOVE_ATR=0.35
LVL_PDH_BAND_BELOW_ATR=0.25
LVL_PDH_BAND_ABOVE_ATR=0.2
LVL_BREAKOUT_MAX_EXT_ATR=1.0
LVL_BREAKOUT_ENTRY_ABOVE_ATR=0.35
LVL_RVOL_BREAKOUT_MIN=1.5
LVL_RETEST_LOOKBACK=6
LVL_RETEST_BELOW_ATR=0.2
LVL_RETEST_ABOVE_ATR=0.35
LVL_RETEST_TOUCH_BARS=3
LVL_RETEST_TOUCH_ABOVE_ATR=0.1
LVL_RETEST_ENTRY_BELOW_ATR=0.2
LVL_RETEST_ENTRY_ABOVE_ATR=0.25
# Entry: ≤CHASE ATR overshoot = GREEN; ≤AMBER ATR = AMBER; above = RED reject
LVL_ENTRY_CHASE_ATR=0.15
LVL_ENTRY_AMBER_ATR=0.50
LVL_ENTRY_MISSED_ATR=0.5
LVL_STOP_ATR_BUFFER=0.35
# Stop width tiers (fraction of buyHigh), with ATR-adaptive floor:
#   greenCap = min(HARD, max(REJECT, ADAPTIVE_MULT * ATR%))
#   amberCap = min(HARD, max(AMBER, greenCap))
LVL_MAX_STOP_PCT_REJECT=0.08
LVL_MAX_STOP_PCT_AMBER=0.15
LVL_MAX_STOP_PCT_HARD=0.15
# Strategy BUYABLE risk budget (fraction of buyHigh). Natural stop is not tightened.
LVL_MAX_RISK_PCT=0.04
LVL_STOP_ADAPTIVE_ATR_MULT=2.5
LVL_MAX_STOP_ATR_REJECT=2.5
LVL_MAX_STOP_ATR_AMBER=3.5
# GREEN / AMBER RR quality bands (not a hard discard before AI).
# Structural targets with RR ≥ 1.0 can still be BUYABLE; below → WATCH.
LVL_MIN_TARGET_RR=2.0
LVL_MIN_TARGET_RR_AMBER=1.5
LVL_MAX_RESISTANCE_TARGETS=3
# Horizon: 0.5–4% is typical; 8% is slightly outside; ATR cap is a second sanity check.
LVL_MAX_TARGET_PCT=0.08
LVL_MAX_TARGET_ATR=1.5
LVL_MAX_HOLD_SESSIONS=5

# =============================================================================
# Live execution / AI position management (does NOT change V1 trade-plan levels)
# =============================================================================
# Master switch for the AI portfolio loop. Buy/sell quote-freshness safety is always on.
LIVE_MGMT_ENABLED=true
# Portfolio-level AI reassessment while positions are OPEN (default 5 minutes).
LIVE_AI_INTERVAL_MS=300000
LIVE_EVENT_AI_ENABLED=true
# Fetch recency (receivedAt). Execution quotes are fetched immediately before orders.
LIVE_QUOTE_MAX_AGE_MS=30000
# Vendor/exchange timestamp ceiling. Yahoo NSE is often delayed; tighten when a
# true broker feed is wired. 20 minutes = 1200000ms.
LIVE_QUOTE_MAX_EXCHANGE_DELAY_MS=1200000
# Event thresholds: leave empty to disable. Set after independent backtests.
# Fractions unless noted (0.15 = 15% of stop/target distance remaining).
LIVE_EVENT_NEAR_STOP_PCT=
LIVE_EVENT_NEAR_TARGET_PCT=
LIVE_EVENT_LARGE_PRICE_MOVE_PCT=
LIVE_EVENT_VOLUME_SPIKE_MULT=
LIVE_EVENT_VWAP_BREAK_PCT=
LIVE_EVENT_PNL_PCT=
LIVE_EVENT_STALE_TRADE_MS=
LIVE_EVENT_MARKET_MOVE_PCT=
LIVE_EVENT_STRUCTURE_ENABLED=false
LIVE_EVENT_MOMENTUM_ENABLED=false
# Partial-profit quantity policy is not configured yet.
LIVE_PARTIAL_PROFIT_ENABLED=false
