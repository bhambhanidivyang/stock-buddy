# =============================================================================
# Stock Buddy — single env template (Nest local + Docker Compose)
#
#   cp backend/.env.example backend/.env
#   # edit secrets in backend/.env
#
# Compose (from repo root):
#   docker compose --env-file backend/.env up -d --build
#
# Local Nest uses DATABASE_HOST=localhost.
# Compose overrides DATABASE_HOST=postgres in docker-compose.yml.
# =============================================================================

# Postgres role used by the DB container and the Nest TypeORM connection.
POSTGRES_USER=postgres
# Postgres password (change in production).
POSTGRES_PASSWORD=postgres
# Database name created on first boot.
POSTGRES_DB=stock-buddy-dev
# Host Nest connects to. Local: localhost. Compose sets this to postgres.
DATABASE_HOST=localhost
# Postgres port Nest connects to.
DATABASE_PORT=5432

# JWT signing secret for login sessions. Required — long random string
# (e.g. openssl rand -base64 48).
JWT_SECRET=change-me-to-a-long-random-secret

# Nest IST cron jobs (off by default for local dev).
# Weekdays: 18:30 nse_sync · 08:45 recommend · 09:14 execute (if auto).
# Master switch for those crons.
SCHEDULER_ENABLED=false
# If true, the 09:14 cron also places paper orders for the morning BUYABLE picks.
SCHEDULER_AUTO_EXECUTE=false

# Paper starting cash (INR) used for allocation / leftover math.
DAILY_FUND=100000

# AI provider for recommendations and live position management: mock | openai.
AI_PROVIDER=openai

# OpenAI API key. Required when AI_PROVIDER=openai.
OPENAI_API_KEY=sk-...

# OpenAI model id for recommendation + live-management calls.
OPENAI_MODEL=gpt-5.6-luna

# How often the execution loop polls open orders / quotes (milliseconds).
POLL_INTERVAL_MS=10000
# Nest HTTP listen port (inside the container this is always 3000).
PORT=3000

# CORS: browser origin of the Next.js UI (comma-separated if needed).
# Local: http://localhost:3001
# OCI:   http://YOUR_PUBLIC_IP:3001
FRONTEND_ORIGIN=http://localhost:3001

# =============================================================================
# Docker Compose host ports + browser API URL (used by compose / frontend build)
# =============================================================================
# Host port mapped to the backend container's 3000.
BACKEND_HOST_PORT=3000
# Host port mapped to the frontend container's 3001.
FRONTEND_HOST_PORT=3001

# Baked into the Next.js client at frontend image build time.
# Must be reachable from the browser (not Docker DNS like http://backend:3000).
# Local: http://localhost:3000  ·  OCI: http://YOUR_PUBLIC_IP:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# =============================================================================
# Recommendation knobs (all required — no code defaults)
# =============================================================================
# Holding style passed to the AI prompt: day | swing.
REC_STRATEGY_PROFILE=swing
# If true, the allocator tries to put almost all cash to work (subject to leftover caps).
REC_FULL_CASH_DEPLOY=true
# Max fraction of available cash in one name.
REC_MAX_ALLOC_PCT=0.35
# Min fraction of available cash in one name (smaller clips are skipped).
REC_MIN_ALLOC_PCT=0.08
# Max unused cash as a fraction of DAILY_FUND after allocation.
REC_MAX_CASH_LEFTOVER_PCT=0.02
# Max unused cash in INR after allocation (whichever leftover cap is tighter wins).
REC_MAX_CASH_LEFTOVER_INR=2500
# Skip allocation entirely if leftover cash is below this INR (too small to deploy).
REC_MIN_DEPLOY_CASH_INR=2500
# Max recommendation runs per account per IST calendar day.
REC_MAX_PER_DAY=5
# Max names from the same sector in one recommendation batch.
REC_MAX_PER_SECTOR=2
# How the morning shortlist is built: activity (legacy movers) | ranking (research engine).
REC_SHORTLIST_MODE=ranking
# Names sent to AI after shortlist. When ranking, keep aligned with RANK_TOP_K.
REC_CANDIDATE_LIMIT=40
# Universe size scored before the shortlist is cut (activity/priority path).
REC_PRIORITY_POOL=400
# Minimum average daily traded value in INR to stay in the liquid universe.
REC_MIN_ADTV=50000000
# Sessions used to compute that ADTV.
REC_ADTV_LOOKBACK=20
# Minimum daily bars of history required before a name can be recommended.
REC_MIN_HISTORY=220
# Share-price floor (INR). Mid/small names like ₹20–80 are fine; only junk below this is cut.
REC_MIN_PRICE=10
# If true, extra technical fields are included in the AI prompt (larger, costlier).
REC_AI_INCLUDE_EXTENDED=false
# If true, the full prompt text is stored in activity logs (verbose / PII-ish).
REC_STORE_FULL_PROMPT=false
# Price-match tolerance (fraction) when validating AI-proposed levels vs engine levels.
REC_LEVELS_TOLERANCE=0.05
# Activity-priority score weight for relative volume.
REC_PRIORITY_WEIGHT_RVOL=1
# Activity-priority score weight for overnight gap.
REC_PRIORITY_WEIGHT_GAP=1
# Activity-priority score weight for absolute day return.
REC_PRIORITY_WEIGHT_ABS_RETURN=1
# Tag a name when |change %| is at least this (used in activity reasons).
REC_PRIORITY_CHANGE_TAG_MIN=2
# Tag a name when |gap %| is at least this.
REC_PRIORITY_GAP_TAG_MIN=1.5
# Tag a name when RVOL is at least this.
REC_PRIORITY_RVOL_TAG_MIN=1.5
# Cap RVOL's contribution to the activity priority score.
REC_PRIORITY_RVOL_SCORE_CAP=10
# Fallback volume score when ADTV is missing.
REC_PRIORITY_VOLUME_FALLBACK_MIN=1000000

# -----------------------------------------------------------------------------
# Research Ranking Engine (used when REC_SHORTLIST_MODE=ranking)
# -----------------------------------------------------------------------------
# How many ranked names become the AI shortlist (keep ≈ REC_CANDIDATE_LIMIT).
RANK_TOP_K=40
# How many sectors are treated as "in play" for the main pool.
RANK_SECTOR_TOP_N=5
# Max names kept from one sector before wildcards.
RANK_PER_SECTOR_POOL=16
# Sector mix: strict | soft | hybrid (hybrid = sector leaders + wildcards).
RANK_SECTOR_MODE=hybrid
# Fraction of the shortlist reserved for names outside the top sectors.
RANK_WILDCARD_PCT=0.20
# Max fraction of the shortlist that may come from one sector.
RANK_MAX_SECTOR_SHARE=0.25
# Sector is ignored as a bucket unless it has at least this many liquid members.
RANK_MIN_SECTOR_MEMBERS=8
# When a factor is missing: redistribute its weight | exclude the name.
RANK_MISSING_POLICY=redistribute
# If true, a no-trade market regime can empty the shortlist. Keep false until tested.
RANK_REGIME_NOTRADE_ENABLED=false
# If true, skip the 20-session RS factor on the ranking day itself (stale-bhav safety).
RANK_SKIP_DAY_RS20=true
# Short relative-strength lookback (sessions).
RANK_RS_LB_SHORT=5
# Swing relative-strength lookback (sessions). RANK_BHAV_LOOKBACK must be > this.
RANK_RS_LB_SWING=20
# Intermediate relative-strength lookback (sessions).
RANK_RS_LB_INTERMEDIATE=63
# ADX period used as a trend-strength feature.
RANK_ADX_PERIOD=14
# Bars used for 52-week / near-high features (≈ 1 year of sessions).
RANK_52W_BARS=252
# Soft penalty starts when price is this many ATR above the relevant high.
RANK_EXT_SOFT_ATR=2.5
# Extra Yahoo deep-history names considered as wildcard candidates.
RANK_WILDCARD_CANDIDATE_POOL=40
# Bhav sessions for cheap return20 preview (must be >= RANK_RS_LB_SWING + 1).
RANK_BHAV_LOOKBACK=30
# Fail closed if fewer than this fraction of liquid names have return20.
RANK_MIN_RETURN20_COVERAGE=0.50
# Ranking weight: relative strength. Category weights should sum ≈ 1.
RANK_W_RS=0.25
# Ranking weight: trend (EMA/ADX stack).
RANK_W_TREND=0.25
# Ranking weight: proximity to 52-week / Donchian high.
RANK_W_NEAR_HIGH=0.15
# Ranking weight: persistence of the move.
RANK_W_PERSISTENCE=0.15
# Ranking weight: sector leadership.
RANK_W_SECTOR=0.10
# Ranking weight: volume / participation.
RANK_W_VOLUME=0.10
# Ranking weight: event score. 0 = disabled (do not invent events).
RANK_W_EVENT=0.00

# =============================================================================
# Level / setup engine (LVL_*) — all required
#
# BREAKOUT_FRESH
#   Close > highest close of prior LVL_BREAKOUT_LOOKBACK_DAYS bars
#   RVOL >= LVL_RVOL_BREAKOUT_MIN
#   ADX >= LVL_ADX_MIN
#   Close - breakLevel <= LVL_BREAKOUT_MAX_EXT_ATR * ATR
#
# BREAKOUT_RETEST
#   Close-break of that lookback high occurred age 1..LVL_RETEST_LOOKBACK ago
#   Close in [R - LVL_RETEST_BELOW_ATR*ATR, R + LVL_RETEST_ABOVE_ATR*ATR]
#   Last LVL_RETEST_TOUCH_BARS: touched R and held above band floor
#   ADX >= LVL_ADX_MIN
#
# PULLBACK_EMA20
#   EMA20 > EMA50; ADX >= LVL_ADX_MIN
#   Touched EMA20 in last LVL_EMA_TOUCH_BARS; close in EMA pullback band
#
# PULLBACK_PDH
#   EMA20 > EMA50; ADX >= LVL_ADX_MIN
#   PDH broken in LVL_PDH_BREAK_LOOKBACK; close retesting current PDH band
# =============================================================================
# Fractal / swing pivot half-window (bars on each side).
LVL_SWING_WINDOW=2
# Merge nearby swing levels if they are within this many ATR.
LVL_CLUSTER_ATR=0.25
# Extra ATR buffer required to count a level as broken.
LVL_BREAK_BUFFER_ATR=0.1
# Minimum touches for a clustered level to count as structure.
LVL_MIN_TOUCHES=1
# Donchian lookback (prior bars, excluding signal bar) for breakout level.
LVL_BREAKOUT_LOOKBACK_DAYS=20
# Minimum ADX for all four setups.
LVL_ADX_MIN=25
# EMA20 pullback: close must be within this ATR of EMA20 (band centre).
LVL_EMA_PULLBACK_ATR=0.15
# EMA20 pullback reject if close is more than this ATR above EMA20 (extended).
LVL_EMA_MAX_EXT_ATR=1.0
# EMA20 pullback: how far below EMA20 the buy band may extend (ATR).
LVL_EMA_BAND_BELOW_ATR=0.25
# EMA20 must have been touched within this many recent bars.
LVL_EMA_TOUCH_BARS=3
# Sessions to look back for a prior-day-high (PDH) break.
LVL_PDH_BREAK_LOOKBACK=5
# PDH retest: close may sit this many ATR below current PDH.
LVL_PDH_RETEST_BELOW_ATR=0.25
# PDH retest: close may sit this many ATR above current PDH.
LVL_PDH_RETEST_ABOVE_ATR=0.35
# PDH buy band floor: this many ATR below PDH.
LVL_PDH_BAND_BELOW_ATR=0.25
# PDH buy band ceiling: this many ATR above PDH.
LVL_PDH_BAND_ABOVE_ATR=0.2
# Fresh breakout reject if close is more than this ATR above the break level.
LVL_BREAKOUT_MAX_EXT_ATR=1.0
# Fresh breakout buy band ceiling: this many ATR above the break level.
LVL_BREAKOUT_ENTRY_ABOVE_ATR=0.35
# Fresh breakout minimum relative volume.
LVL_RVOL_BREAKOUT_MIN=1.5
# Max age (bars) of the original break for a retest setup.
LVL_RETEST_LOOKBACK=6
# Retest close band: this many ATR below resistance R.
LVL_RETEST_BELOW_ATR=0.2
# Retest close band: this many ATR above resistance R.
LVL_RETEST_ABOVE_ATR=0.35
# Bars that must show a touch-and-hold of R for retest confirmation.
LVL_RETEST_TOUCH_BARS=3
# Max distance above R (ATR) for a low to count as "touched" R.
LVL_RETEST_TOUCH_ABOVE_ATR=0.1
# Retest buy band floor: this many ATR below R.
LVL_RETEST_ENTRY_BELOW_ATR=0.2
# Retest buy band ceiling: this many ATR above R.
LVL_RETEST_ENTRY_ABOVE_ATR=0.25
# Entry quality: LTP overshoot above buyHigh ≤ this ATR = GREEN.
LVL_ENTRY_CHASE_ATR=0.15
# Entry quality: LTP overshoot above buyHigh ≤ this ATR = AMBER; above = RED reject.
LVL_ENTRY_AMBER_ATR=0.50
# LTP this far below buyLow (ATR) counts as a missed entry.
LVL_ENTRY_MISSED_ATR=0.5
# Structural stop is placed this many ATR beyond the invalidation level (PDL/swing).
LVL_STOP_ATR_BUFFER=0.35
# Stop width as a fraction of buyHigh. Green floor / adaptive base.
# greenCap = min(HARD, max(REJECT, ADAPTIVE_MULT * ATR%)); amberCap = min(HARD, max(AMBER, greenCap)).
LVL_MAX_STOP_PCT_REJECT=0.08
# Amber stop-width ceiling as a fraction of buyHigh (quality band, not BUYABLE budget).
LVL_MAX_STOP_PCT_AMBER=0.15
# Absolute hard reject stop width as a fraction of buyHigh.
LVL_MAX_STOP_PCT_HARD=0.15
# Strategy BUYABLE risk budget (fraction of buyHigh). Natural stop is not tightened.
LVL_MAX_RISK_PCT=0.04
# Expands green/amber stop % ceilings: max(pctKnob, this * ATR/buyHigh).
LVL_STOP_ADAPTIVE_ATR_MULT=2.5
# Green max stop width in ATR units.
LVL_MAX_STOP_ATR_REJECT=2.5
# Amber max stop width in ATR units.
LVL_MAX_STOP_ATR_AMBER=3.5
# GREEN / AMBER RR quality bands (not a hard discard before AI).
# Structural targets with RR ≥ 1.0 can still be BUYABLE; below → WATCH.
# Green minimum risk/reward at buyHigh.
LVL_MIN_TARGET_RR=2.0
# Amber minimum risk/reward (still shown to AI).
LVL_MIN_TARGET_RR_AMBER=1.5
# Max nearby resistance levels considered as candidate targets.
LVL_MAX_RESISTANCE_TARGETS=3
# Horizon: 0.5–4% is typical; 8% is slightly outside; ATR cap is a second sanity check.
# Max BUYABLE target distance as a fraction of buyHigh. Far measured moves are skipped, not clamped.
LVL_MAX_TARGET_PCT=0.08
# Max BUYABLE target distance in ATR. Same skip-not-clamp rule.
LVL_MAX_TARGET_ATR=1.5
# Sessions after buyAt before the time-stop can flatten the trade.
LVL_MAX_HOLD_SESSIONS=5

# =============================================================================
# Live execution / AI position management (does NOT change V1 trade-plan levels)
# =============================================================================
# Master switch for the AI portfolio loop. Buy/sell quote-freshness safety is always on.
LIVE_MGMT_ENABLED=true
# Portfolio-level AI reassessment while positions are OPEN (milliseconds; 300000 = 5 min).
LIVE_AI_INTERVAL_MS=300000
# If true, an event fire can request an extra AI pass between cadence ticks.
LIVE_EVENT_AI_ENABLED=true
# Max age of quote receipt (receivedAt) allowed for execution. Quotes are fetched immediately before orders.
LIVE_QUOTE_MAX_AGE_MS=30000
# Vendor/exchange timestamp ceiling. Yahoo NSE is often delayed; tighten when a
# true broker feed is wired. 20 minutes = 1200000ms.
LIVE_QUOTE_MAX_EXCHANGE_DELAY_MS=1200000
# Event thresholds: leave empty to disable. Set after independent backtests.
# Fractions unless noted (0.15 = 15% of stop/target distance remaining).
# Fire when price is this fraction of stop-distance remaining.
LIVE_EVENT_NEAR_STOP_PCT=
# Fire when price is this fraction of target-distance remaining.
LIVE_EVENT_NEAR_TARGET_PCT=
# Fire when last move vs reference is at least this fraction.
LIVE_EVENT_LARGE_PRICE_MOVE_PCT=
# Fire when volume / typical volume exceeds this multiple.
LIVE_EVENT_VOLUME_SPIKE_MULT=
# Fire when price is this fraction through VWAP (break).
LIVE_EVENT_VWAP_BREAK_PCT=
# Fire when open P/L fraction vs entry exceeds this.
LIVE_EVENT_PNL_PCT=
# Fire when the trade has been open this many milliseconds with no management.
LIVE_EVENT_STALE_TRADE_MS=
# Fire when the broad market (index) move exceeds this fraction.
LIVE_EVENT_MARKET_MOVE_PCT=
# If true, structure-break events (level invalidation) can trigger extra AI. Keep false until tested.
LIVE_EVENT_STRUCTURE_ENABLED=false
# If true, momentum-shift events can trigger extra AI. Keep false until tested.
LIVE_EVENT_MOMENTUM_ENABLED=false
# Partial-profit quantity policy is not configured yet. Keep false.
LIVE_PARTIAL_PROFIT_ENABLED=false
