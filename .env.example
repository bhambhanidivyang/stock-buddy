# =============================================================================
# Stock Buddy — shared production / OCI compose env
# Copy to `.env` at the repo root (same folder as docker-compose.yml):
#   cp .env.example .env
# Then edit secrets and host URLs.
# =============================================================================

# --- Postgres (private Docker network only) ---
POSTGRES_USER=stockbuddy
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=stockbuddy

# --- Backend DB connection (compose overrides HOST to "postgres") ---
DATABASE_HOST=postgres
DATABASE_PORT=5432

# --- Auth ---
# openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret

# --- Paper fund ---
DAILY_FUND=100000

# --- AI ---
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6-luna

# --- API ---
PORT=3000
POLL_INTERVAL_MS=10000

# CORS: browser origin of the Next.js UI (use your VM public IP or DNS)
# Example: http://130.61.x.x:3001
FRONTEND_ORIGIN=http://localhost:3001

# --- Scheduler (IST) — enable on the VM for unattended paper days ---
SCHEDULER_ENABLED=true
SCHEDULER_AUTO_EXECUTE=false

# --- Recommendation knobs (all required — no code defaults) ---
REC_STRATEGY_PROFILE=swing
REC_FULL_CASH_DEPLOY=true
REC_MAX_ALLOC_PCT=0.35
REC_MIN_ALLOC_PCT=0.08
REC_MAX_CASH_LEFTOVER_PCT=0.02
REC_MAX_CASH_LEFTOVER_INR=2500
REC_MIN_DEPLOY_CASH_INR=2500
REC_MAX_PER_DAY=3
REC_MAX_PER_SECTOR=2
REC_CANDIDATE_LIMIT=120
REC_PRIORITY_POOL=400
REC_MIN_ADTV=50000000
REC_ADTV_LOOKBACK=20
REC_MIN_HISTORY=220
REC_MIN_PRICE=10
REC_AI_INCLUDE_EXTENDED=false
REC_STORE_FULL_PROMPT=false
REC_LEVELS_TOLERANCE=0.05
REC_PRIORITY_WEIGHT_RVOL=1
REC_PRIORITY_WEIGHT_GAP=1
REC_PRIORITY_WEIGHT_ABS_RETURN=1
REC_PRIORITY_CHANGE_TAG_MIN=2
REC_PRIORITY_GAP_TAG_MIN=1.5
REC_PRIORITY_RVOL_TAG_MIN=1.5
REC_PRIORITY_RVOL_SCORE_CAP=10
REC_PRIORITY_VOLUME_FALLBACK_MIN=1000000

# --- Level / setup engine (see backend/.env.example for setup definitions) ---
LVL_SWING_WINDOW=2
LVL_CLUSTER_ATR=0.25
LVL_BREAK_BUFFER_ATR=0.1
LVL_MIN_TOUCHES=1
LVL_BREAKOUT_LOOKBACK_DAYS=20
LVL_ADX_MIN=25
LVL_EMA_PULLBACK_ATR=0.15
LVL_EMA_MAX_EXT_ATR=1.0
LVL_EMA_BAND_BELOW_ATR=0.25
LVL_EMA_TOUCH_BARS=3
LVL_PDH_BREAK_LOOKBACK=5
LVL_PDH_RETEST_BELOW_ATR=0.25
LVL_PDH_RETEST_ABOVE_ATR=0.35
LVL_PDH_BAND_BELOW_ATR=0.25
LVL_PDH_BAND_ABOVE_ATR=0.2
LVL_BREAKOUT_MAX_EXT_ATR=1.0
LVL_BREAKOUT_ENTRY_ABOVE_ATR=0.35
LVL_RVOL_BREAKOUT_MIN=1.5
LVL_RETEST_LOOKBACK=6
LVL_RETEST_BELOW_ATR=0.2
LVL_RETEST_ABOVE_ATR=0.35
LVL_RETEST_TOUCH_BARS=3
LVL_RETEST_TOUCH_ABOVE_ATR=0.1
LVL_RETEST_ENTRY_BELOW_ATR=0.2
LVL_RETEST_ENTRY_ABOVE_ATR=0.25
LVL_ENTRY_CHASE_ATR=0.15
LVL_ENTRY_MISSED_ATR=0.5
LVL_STOP_ATR_BUFFER=0.35
LVL_MAX_STOP_PCT_REJECT=0.08
LVL_MAX_STOP_ATR_REJECT=2.5
LVL_MIN_TARGET_RR=2.0
LVL_MAX_RESISTANCE_TARGETS=3
LVL_MAX_TARGET_ATR=4
LVL_MAX_HOLD_SESSIONS=5

# --- Host publish + browser API URL ---
BACKEND_HOST_PORT=3000
FRONTEND_HOST_PORT=3001

# Baked into the Next.js client at build time. Must be reachable from browsers
# on the internet (VM public IP:BACKEND_HOST_PORT). Do NOT use http://backend:3000
# Example: http://130.61.x.x:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
